# ============================================================================
# VigaDesk - Frontend Next.js - Variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores si es necesario.
# ============================================================================

# URL interna del reverse proxy HAProxy. Dentro de docker-compose apunta al
# contenedor; en desarrollo local apuntá al gateway u host correspondiente.
HAPROXY_URL=http://haproxy:80

# URL que usa Next.js (SSR) para auto-consultarse a través de HAProxy.
SSR_FETCH_URL=http://haproxy
