<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dan</groupId>
    <artifactId>vigadesk</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>VigaDesk</name>
    <description>Parent POM for VigaDesk microservices</description>

    <modules>
        <module>backend/dan-eureka-srv</module>
        <module>backend/dan-gateway</module>
        <module>backend/ms-clientes</module>
        <module>backend/ms-pedidos</module>
        <module>backend/ms-productos</module>
    </modules>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- Dependencias sobre los módulos: necesarias para que jacoco
         report-aggregate (ver <build>) pueda leer el jacoco.exec y las
         clases de cada módulo del reactor y fusionarlos en una sola página. -->
    <dependencies>
        <dependency>
            <groupId>dan.ms</groupId>
            <artifactId>eureka-srv</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>dan.ms.tp</groupId>
            <artifactId>dan-gateway</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>isi.dan</groupId>
            <artifactId>ms-clientes</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>isi.dan</groupId>
            <artifactId>ms-pedidos</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>isi.dan</groupId>
            <artifactId>ms-productos</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Reporte único de cobertura para los 5 módulos. Se ejecuta en
                 verify, ya con el jacoco.exec de cada módulo del reactor, y
                 deja la página en target/site/jacoco-aggregate/index.html.
                 Los excludes replican los criterios que cada módulo aplica
                 a su reporte individual para que las cifras coincidan. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <exclude>**/model/**</exclude>
                        <exclude>**/modelo/**</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/aop/**</exclude>
                        <exclude>**/config/DataInitializer*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
