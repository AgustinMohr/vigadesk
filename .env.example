# Copiar a .env (ignorado por git) y completar valores reales.
# Generacion sugerida: openssl rand -base64 32 (o alfanumerico para Mongo).

# ===== MySQL (ms-clientes) =====
MYSQL_DATABASE=dandb
MYSQL_USER=danuser
MYSQL_PASSWORD=__SET__
MYSQL_ROOT_PASSWORD=__SET__

# ===== PostgreSQL (ms-productos) =====
POSTGRES_DB=pg-dan
POSTGRES_USER=pguser
POSTGRES_PASSWORD=__SET__

# ===== MongoDB (ms-pedidos) =====
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=__SET__


# ===== Seguridad =====
JWT_SECRET=__SET_MIN_64_CHARS__
JWT_EXPIRATION_SECONDS=7200

# ===== Primer administrador (solo produccion) =====
# Se usan unicamente si la base de usuarios esta vacia. Contraseña de al menos 12 caracteres.
# Con docker-compose.prod.yml, si la base esta vacia y faltan, ms-clientes no arranca.
# Una vez creado el administrador se pueden borrar de .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ===== Observabilidad =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__SET__

# ===== Datos del corralón (PDF) =====
CORRALON_NOMBRE=Corralon de Materiales
CORRALON_CUIT=30-00000000-0
CORRALON_DIRECCION=Direccion del corralon
CORRALON_TELEFONO=000-000-0000

# ===== Frontend (server-side) =====
HAPROXY_URL=http://haproxy:80
SSR_FETCH_URL=http://haproxy
