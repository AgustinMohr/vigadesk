# ============================================================================
# tp-dan-2024 - Variables de entorno (copiar a .env y ajustar)
# Copia este archivo a `.env` en la raíz y cambia los valores en entornos
# distintos de desarrollo local. NUNCA commits `.env`.
#
# Todos los valores tienen defaults seguros para desarrollo, de modo que
# `docker-compose up -d` funciona sin .env.
# ============================================================================

# ==== MySQL (ms-clientes) ====
MYSQL_ROOT_PASSWORD=danrootpassword
MYSQL_DATABASE=dandb
MYSQL_USER=danuser
MYSQL_PASSWORD=danpassword

# ==== PostgreSQL (ms-productos) ====
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpassword
POSTGRES_DB=pg-dan

# ==== MongoDB (ms-pedidos) ====
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=dan

# ==== RabbitMQ (broker) ====
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ==== JWT (firma y validación de tokens) ====
# OBLIGATORIO cambiarlo en cualquier entorno que no sea desarrollo local.
# Mínimo 32 caracteres para HS256.
JWT_SECRET=dev-only-secret-change-me-1234567890-abcdef

# ==== Frontend ====
# URL interna del reverse proxy (usada por el BFF route handler de Next.js)
HAPROXY_URL=http://haproxy:80
